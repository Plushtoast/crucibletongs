<div style="--iniTrackerSize:{{itemWidth}}px">
    <div class="flexrow">
        <div class="controls right flex0">
            {{#if (and user.isGM combat.round)}}
            <button type="button" class="frame-brown inline-control combat-control icon fa-solid encounter-context-menu fa-ellipsis-vertical"></button>
            <button type="button" class="frame-brown inline-control combat-control icon fa-solid fa-step-backward"
            data-action="previousRound" data-tooltip="COMBAT.RoundPrev"
            aria-label="{{ localize "COMBAT.RoundPrev" }}"></button>
            <button type="button" class="frame-brown inline-control combat-control icon fa-solid fa-arrow-left" data-action="previousTurn"
            data-tooltip-text="{{tooltipWithKeybinding 'COMBAT.TurnPrev' 'combatTrackerPrevious'}}" aria-label="{{ localize "COMBAT.TurnPrev" }}"></button>
            {{else if control}}
            <button type="button" class="frame-brown inline-control combat-control icon fa-solid fa-arrow-left" data-action="previousTurn"
            data-tooltip-text="{{tooltipWithKeybinding 'COMBAT.TurnPrev' 'combatTrackerPrevious'}}" aria-label="{{ localize "COMBAT.TurnPrev" }}"></button>
            {{/if}}
        </div>
        <ul class="iniTrackerList flex1">
            {{#each turns}}
            <li data-combatant-id="{{id}}" data-action="activateCombatant" class="combatant iniItem {{css}}" style="background-image:url('{{img}}');"{{#if canViewActorStats}} data-tooltip-html="{{defenseTooltip}}" data-tooltip-class="crucible crucible-tooltip"{{/if}}>
                <div class="combatant-advanced"></div>
                {{#if canViewActorStats}}
                <div class="item-structure" style="--a: {{maxLP}}; --b: {{currentLP}}">
                    <div class="inner"></div>
                </div>
                <div class="item-structure second" style="--a: {{maxM}}; --b: {{currentM}}">
                    <div class="inner"></div>
                </div>
                {{/if}}
                <div class="hoverbuttons">
                    <div class="combatant-controls flexrow">
                        {{#if ../user.isGM}}
                        <button type="button" class="frame-brown inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                        data-action="toggleHidden" data-tooltip
                        aria-label="{{ localize (ifThen hidden "COMBATANT.Show" "COMBATANT.Hide") }}"></button>
                    </div>
                    <div class="combatant-controls flexrow">
                        <button type="button" class="frame-brown inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                        data-action="toggleDefeated" data-tooltip
                        aria-label="{{ localize (ifThen isDefeated "COMBATANT.UnmarkDefeated" "COMBATANT.MarkDefeated") }}"></button>
                        {{/if}}
                    </div>
                </div>
            </li>
            {{/each}}
            {{#if showEndOfRoundBox}}
            <li class="iniItem next-round-box" data-tooltip="{{localize 'COMBAT.RoundNext'}}">
                <div class="next-round-content">
                    <i class="fa-solid fa-dice-d20"></i>
                    <span class="next-round-number">{{nextRound}}</span>
                </div>
            </li>
            {{/if}}
        </ul>
        <div class="controls flex0">
            {{#if user.isGM}}
            <button type="button" class="frame-brown inline-control combat-control icon fa-solid fa-trash" data-action="endCombat"
                data-tooltip="COMBAT.End" aria-label="{{ localize "COMBAT.End" }}"></button>

            {{#if combat.round}}
            <button type="button" class="frame-brown inline-control combat-control icon fa-solid fa-step-forward" data-action="nextRound"
            data-tooltip="COMBAT.RoundNext" aria-label="{{ localize "COMBAT.RoundNext" }}"></button>
            <button type="button" class="frame-brown inline-control combat-control icon fa-solid fa-arrow-right" data-action="nextTurn"
            data-tooltip-text="{{tooltipWithKeybinding 'COMBAT.TurnNext' 'combatTrackerNext'}}" aria-label="{{ localize "COMBAT.TurnNext" }}"></button>
            {{else if control}}
            <button type="button" class="frame-brown inline-control combat-control icon fa-solid fa-arrow-right" data-action="nextTurn"
            data-tooltip-text="{{tooltipWithKeybinding 'COMBAT.TurnNext' 'combatTrackerNext'}}" aria-label="{{ localize "COMBAT.TurnNext" }}"></button>
            {{/if}}

            {{/if}}
        </div>
        <section class="dragHandler flex0">
            <i class="fas fa-grip-vertical"></i>
        </section>
        <div class="resize-handle flex0" data-tooltip="crucibletongs.SETTINGS.combatTracker.resizeHint" aria-label="{{localize 'crucibletongs.SETTINGS.combatTracker.resizeHint'}}"></div>
    </div>

    {{#unless combat.round}} 
    {{#if user.isGM}}
    <div class="flexrow">
        <button type="button" class="combat-control frame-brown" data-action="startCombat">{{localize 'COMBAT.Begin'}}</button>
    </div>
    {{/if}}
    {{else}}
    {{#if (or control user.isGM)}}
    {{#unless showActiveCombatantActions}}
    <div class="flexrow">
        <button type="button" class="combat-control frame-brown {{ifThen isLastTurn 'lastRound' ''}}" data-action="nextTurn" data-tooltip-text="{{tooltipWithKeybinding (ifThen isLastTurn 'COMBAT.RoundNext' 'COMBAT.TurnEnd') 'combatTrackerNext'}}">{{localize (ifThen isLastTurn 'COMBAT.RoundNext' 'COMBAT.TurnEnd')}}</button>
        <button type="button" class="combat-control frame-brown" data-action="waitInit">{{localize 'crucibletongs.waitInit'}}</button>
    </div>
    {{/unless}}
    {{/if}}
    {{#if showActiveCombatantActions}}
    <div class="active-combatant-resources flexrow">
        <div class="resource-box action"
            data-tooltip="{{activeCombatantResources.action.label}} {{activeCombatantResources.action.value}}/{{activeCombatantResources.action.max}}">
            <div class="crucible-rank-pips flexrow">
                {{#each activeCombatantResources.action.pips as |pip|}}
                <span class="pip {{pip.cssClass}}"></span>
                {{/each}}
            </div>
        </div>
        <div class="resource-box focus"
            data-tooltip="{{activeCombatantResources.focus.label}} {{activeCombatantResources.focus.value}}/{{activeCombatantResources.focus.max}}">
            <div class="crucible-rank-pips flexrow">
                {{#each activeCombatantResources.focus.pips as |pip|}}
                <span class="pip {{pip.cssClass}}"></span>
                {{/each}}
            </div>
        </div>
        <div class="resource-box heroism"
            data-tooltip="{{activeCombatantResources.heroism.label}} {{activeCombatantResources.heroism.value}}/{{activeCombatantResources.heroism.max}}">
            <div class="crucible-rank-pips flexrow">
                {{#each activeCombatantResources.heroism.pips as |pip|}}
                <span class="pip {{pip.cssClass}}"></span>
                {{/each}}
            </div>
        </div>
    </div>
    {{#if (or control user.isGM)}}
    <div class="ini-turn-controls flexrow">
        <button type="button" class="ini-turn-control frame-brown inline-control combat-control icon fa-solid {{ifThen isLastTurn 'fa-step-forward' 'fa-check'}} {{ifThen isLastTurn 'lastRound' ''}}"
            data-action="nextTurn" data-tooltip-text="{{tooltipWithKeybinding (ifThen isLastTurn 'COMBAT.RoundNext' 'COMBAT.TurnEnd') 'combatTrackerNext'}}"
            aria-label="{{ localize (ifThen isLastTurn 'COMBAT.RoundNext' 'COMBAT.TurnEnd') }}"></button>
        <button type="button" class="ini-turn-control frame-brown inline-control combat-control icon fa-solid fa-clock"
            data-action="waitInit" data-tooltip="crucibletongs.waitInit"
            aria-label="{{ localize 'crucibletongs.waitInit' }}"></button>
    </div>
    {{/if}}
    {{/if}}
    {{/unless}}
</div>