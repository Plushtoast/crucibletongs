<div class="flexcol actor-actions-hud">
    <div class="flexrow temporaryEffects" data-tooltip-direction="UP">
        {{{effects}}}
    </div>
    <nav class="sheet-tabs tabs" aria-role="Form Tab Navigation">

        {{#if hasFavoriteActions}}
        <a class="{{tabs.favorites.cssClass}}" data-action="tab" data-group="sheet" data-tab="favorites" data-tooltip="{{tabs.favorites.label}}">
            <i class="tab-icon fa-solid fa-star"></i>
        </a>
        {{/if}}
        <a class="{{tabs.actions.cssClass}}" data-action="tab" data-group="sheet" data-tab="actions" data-tooltip="{{tabs.actions.label}}">
            <img class="tab-icon" src="systems/crucible/ui/tabs/actions.webp">
        </a>
        <a class="{{tabs.talents.cssClass}}" data-action="tab" data-group="sheet" data-tab="talents" data-tooltip="{{tabs.talents.label}}">
            <img class="tab-icon" src="systems/crucible/ui/tabs/talents.webp">
        </a>
        <a class="{{tabs.macro.cssClass}}" data-action="tab" data-group="sheet" data-tab="macro"
            data-tooltip="{{tabs.macro.label}}">
            <img class="tab-icon" src="systems/crucible/ui/tabs/biography.webp">
        </a>
        <a data-action="configure" data-tooltip="crucibletongs.SETTINGS.CONFIG.Title">
            <i class="tab-icon fa-solid fa-gear"></i>
        </a>
    </nav>

    {{#if hasFavoriteActions}}
    <section class="tab flexcol {{tabs.favorites.cssClass}}" data-group="{{tabs.favorites.group}}" data-tab="{{tabs.favorites.id}}">
        <div class="actions-bar" data-tooltip-direction="UP">
            {{#each favoriteActions as |action key|}}
            <div class="slot" type="button" data-type="{{action.type}}" data-action="action" data-key="{{key}}" data-uuid="{{../actor.uuid}}" data-tooltip-class="crucible crucible-tooltip" data-action-id="{{action.id}}" {{#if action.isAction}}data-crucible-tooltip="action" data-tooltip="{{action.name}}"{{else}}data-tooltip-html="{{action.tooltip}}"{{/if}}>
                <img src="{{action.img}}" />
            </div>
            {{/each}}
        </div>
    </section>
    {{/if}}
    <section class="tab flexcol {{tabs.actions.cssClass}}" data-group="{{tabs.actions.group}}" data-tab="{{tabs.actions.id}}">
        <div class="actions-bar action-items" data-tooltip-direction="UP">
            {{#each actions as |action key|}}
            <div class="slot" type="button" data-type="action" data-action="action" data-key="{{key}}" data-uuid="{{../actor.uuid}}" data-crucible-tooltip="action" data-tooltip-class="crucible crucible-tooltip" data-tooltip="{{action.name}}" data-action-id="{{key}}">
                <img src="{{action.img}}" />
            </div>
            {{/each}}
        </div>
    </section>
    <section class="tab flexcol {{tabs.talents.cssClass}}" data-group="{{tabs.talents.group}}"
        data-tab="{{tabs.talents.id}}">
        <div class="actions-bar" data-tooltip-direction="UP">
            {{#each talents as |action key|}}
            <div class="slot" type="button" data-type="skill" data-action-id="{{action.id}}" data-action="action" data-key="{{key}}" data-tooltip-html="{{action.tooltip}}" data-tooltip-class="crucible crucible-tooltip">
                <img src="{{action.img}}" />
            </div>
            {{/each}}
        </div>
    </section>
    <section class="tab flexcol {{tabs.macro.cssClass}}" data-group="{{tabs.macro.group}}" data-tab="{{tabs.macro.id}}">
        <div class="actions-bar" data-tooltip-direction="UP">
            {{#each slots as |slot|}}
            <div class="slot {{slot.cssClass}}" role="button" data-action="execute" data-slot="{{slot.slot}}"
                style="{{slot.style}}" aria-label="{{slot.ariaLabel}}"
                {{#if slot.tooltip}}data-tooltip-text="{{slot.tooltip}}"{{/if}}>
                {{#if slot.img}}<img src="{{slot.img}}" alt="{{slot.ariaLabel}}">{{/if}}
                <span class="key">{{slot.key}}</span>
            </div>
            {{/each}}
        </div>
    </section>
</div>