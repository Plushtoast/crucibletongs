<div class="flex0 actor-part" data-tooltip-direction="UP">
    <div class="flexrow resources">
        <div class="flex0 resource-pair resource-health {{#unless resources.wounds.value}}single-resource{{/unless}}"
            data-tooltip-html="{{resources.health.label}} {{resources.health.value}}/{{resources.health.max}}{{#if resources.wounds.value}}<br>{{resources.wounds.label}} {{resources.wounds.value}}/{{resources.wounds.max}}{{/if}}"
            style="--resource-accent: {{resources.health.accentColor}};">
            <div class="resource-row">
                <i class="resource-icon fas {{resources.health.icon}}" aria-hidden="true"></i>
                <div class="resource-bar">
                    <span class="resource-bar-fill" style="width: {{resources.health.fillPct}}; background: {{resources.health.barColor}};"></span>
                    <span class="resource-value">{{resources.health.value}}/{{resources.health.max}}</span>
                </div>
            </div>
            {{#if resources.wounds.value}}
            <div class="resource-row secondary">
                <i class="resource-icon fas {{resources.wounds.icon}}" aria-hidden="true"></i>
                <div class="resource-bar">
                    <span class="resource-bar-fill" style="width: {{resources.wounds.fillPct}}; background: {{resources.wounds.barColor}};"></span>
                    <span class="resource-value">{{resources.wounds.value}}/{{resources.wounds.max}}</span>
                </div>
            </div>
            {{/if}}
        </div>
        <div class="flex0 resource-pair resource-morale {{#unless resources.madness.value}}single-resource{{/unless}}"
            data-tooltip-html="{{resources.morale.label}} {{resources.morale.value}}/{{resources.morale.max}}{{#if resources.madness.value}}<br>{{resources.madness.label}} {{resources.madness.value}}/{{resources.madness.max}}{{/if}}"
            style="--resource-accent: {{resources.morale.accentColor}};">
            <div class="resource-row">
                <i class="resource-icon fas {{resources.morale.icon}}" aria-hidden="true"></i>
                <div class="resource-bar">
                    <span class="resource-bar-fill" style="width: {{resources.morale.fillPct}}; background: {{resources.morale.barColor}};"></span>
                    <span class="resource-value">{{resources.morale.value}}/{{resources.morale.max}}</span>
                </div>
            </div>
            {{#if resources.madness.value}}
            <div class="resource-row secondary">
                <i class="resource-icon fas {{resources.madness.icon}}" aria-hidden="true"></i>
                <div class="resource-bar">
                    <span class="resource-bar-fill" style="width: {{resources.madness.fillPct}}; background: {{resources.madness.barColor}};"></span>
                    <span class="resource-value">{{resources.madness.value}}/{{resources.madness.max}}</span>
                </div>
            </div>
            {{/if}}
        </div>
    </div>
    <div class="avatar-container flexrow">
        <div class="avatar-portrait flex0 {{ifThen myTurn 'myRound' ''}}">
            <img class="avatar" src="{{actor.img}}"{{#if defenseTooltip}} data-tooltip-class="crucible crucible-tooltip" data-tooltip-html="{{defenseTooltip}}"{{/if}} />
        </div>
        {{#each weapons}}
        <div data-action="weapon" data-id="{{weapon.id}}" class="weapon" style="{{{style}}}">
            {{#if weapon.img}}
            <img data-tooltip="{{weapon.name}}" data-crucible-tooltip="weapon" data-item-id="{{weapon.id}}" data-uuid="{{weapon.uuid}}" data-tooltip-class="crucible crucible-tooltip" src="{{weapon.img}}" />
            {{else}}
            <i class="fas fa-hand"></i>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{#if inCombat}}
    <div class="pips flexrow"
        data-tooltip="{{resources.action.label}} {{resources.action.value}}/{{resources.action.max}}">
        {{#each resources.action.pips as |pip|}}
        <div class="pip {{pip.cssClass}}"></div>
        {{/each}}
    </div>
    <div class="pips flexrow focus"
        data-tooltip="{{resources.focus.label}} {{resources.focus.value}}/{{resources.focus.max}}">
        {{#each resources.focus.pips as |pip|}}
        <div class="pip {{pip.cssClass}}"></div>
        {{/each}}
    </div>
    <div class="pips flexrow heroism"
        data-tooltip="{{resources.heroism.label}} {{resources.heroism.value}}/{{resources.heroism.max}}">
        {{#each resources.heroism.pips as |pip|}}
        <div class="pip {{pip.cssClass}}"></div>
        {{/each}}
    </div>
    {{/if}}
</div>
